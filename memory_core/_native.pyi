class PyVectorIndex:
    def __init__(self, dim: int, *, allow_zero: bool = False) -> None: ...
    def upsert(self, id: str, vector: list[float]) -> None: ...
    def remove(self, id: str) -> bool: ...
    def search(
        self, query: list[float], ids: list[str], k: int
    ) -> list[tuple[str, float]]: ...

class PyMemoryCandidate:
    @property
    def trace_uid(self) -> str: ...
    @property
    def score(self) -> float: ...
    @property
    def summary(self) -> str: ...
    @property
    def tags(self) -> list[str]: ...
    @property
    def created_at(self) -> int: ...
    @property
    def importance(self) -> float: ...
    @property
    def access_count(self) -> int: ...

class PyMemoryEngine:
    def __init__(
        self,
        semantic_weight: float = 0.7,
        importance_weight: float = 0.3,
        recency_weight: float = 0.0,
        access_weight: float = 0.0,
        recency_half_life_days: float = 30.0,
    ) -> None: ...
    def ingest_trace(
        self,
        trace_uid: str,
        user_id: str,
        summary: str,
        importance: float,
        created_at: int,
        access_count: int,
        tags: list[str],
        embedding: list[float],
    ) -> None: ...
    def mark_accessed(self, trace_uid: str) -> bool: ...
    def remove_trace(self, trace_uid: str) -> bool: ...
    def search_candidates(
        self,
        user_id: str,
        text: str,
        tags: list[str],
        limit: int,
        query_embedding: list[float],
        now: int | None = None,
    ) -> list[PyMemoryCandidate]: ...
    def __len__(self) -> int: ...
    @property
    def embedding_dim(self) -> int | None: ...
